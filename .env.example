NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
DATABASE_URL=postgresql://cge:cge@localhost:5432/intranet_cge
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=cge-local-minio
OBJECT_STORAGE_SECRET_KEY=cge-local-minio-password
OBJECT_STORAGE_BUCKET=intranet-cge
BOOTSTRAP_ADMIN_EMAIL=admin@cge.am.gov.br
BOOTSTRAP_ADMIN_PASSWORD=

# Optional Active Directory integration. Local authentication remains available.
AD_ENABLED=false
