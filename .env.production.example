POSTGRES_DB=intranet_cge
POSTGRES_USER=cge
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cge:replace-with-a-long-random-password@postgres:5432/intranet_cge
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
MINIO_ROOT_USER=replace-with-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-at-least-20-random-characters
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-random-minio-user
OBJECT_STORAGE_SECRET_KEY=replace-with-at-least-20-random-characters
OBJECT_STORAGE_BUCKET=intranet-cge
# Precisa bater exatamente com o endereço digitado no navegador, esquema e
# porta incluídos. A API rejeita escritas vindas de outra origem.
WEB_ORIGIN=https://intranet.cge.am.gov.br
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# TLS terminado pelo Caddy. TLS_SITE_HOST é o host que o Caddy atende e para o
# qual emite o certificado; troque por um nome real quando existir.
TLS_SITE_HOST=intranet.cge.am.gov.br
TLS_BIND_ADDRESS=0.0.0.0
TLS_PORT=443
BOOTSTRAP_ADMIN_EMAIL=admin@cge.am.gov.br
BOOTSTRAP_ADMIN_PASSWORD=
