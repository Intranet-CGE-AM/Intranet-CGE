# Homologação. Copie para .env.homolog na máquina e restrinja com chmod 600.
#
# Use segredos próprios, diferentes dos de produção. Homologação roda sem TLS
# e com cookie de sessão sem Secure; tratar suas credenciais como descartáveis
# é parte do desenho.
POSTGRES_DB=intranet_cge_homolog
POSTGRES_USER=cge
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://cge:replace-with-a-long-random-password@postgres:5432/intranet_cge_homolog
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
MINIO_ROOT_USER=replace-with-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-at-least-20-random-characters
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=replace-with-random-minio-user
OBJECT_STORAGE_SECRET_KEY=replace-with-at-least-20-random-characters
OBJECT_STORAGE_BUCKET=intranet-cge

# Acesso por IP e porta, sem proxy TLS na frente. Precisa bater exatamente com
# o endereço usado no navegador ou a verificação de origem rejeita as escritas.
WEB_ORIGIN=http://10.0.0.9:8081
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8081

# Imagens publicadas pela branch dev.
IMAGE_TAG=homolog

# Credencial de leitura do GHCR usada pelo Watchtower.
DOCKER_CONFIG_FILE=/home/thalison/.docker/config.json
WATCHTOWER_POLL_INTERVAL=120
TZ=America/Manaus

BOOTSTRAP_ADMIN_EMAIL=admin@cge.am.gov.br
BOOTSTRAP_ADMIN_PASSWORD=
